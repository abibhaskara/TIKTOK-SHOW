# Your TikTok username (without the @ symbol) that will be hosting the LIVE stream
TIKTOK_USERNAME=your_tiktok_username

# Optional: Your TikTok sessionid cookie (helps detect existing followers even if they followed before the stream started)
TIKTOK_SESSION_ID=

# Port for the local bridge server (Roblox Studio will poll http://localhost:3000)
PORT=3000

# Set to "true" if you want to allow ANY viewer to spawn during testing, or "false" to strictly require following
BYPASS_FOLLOWER_CHECK=false

